# =========================================================================
# Voice of a Girl platform — backend environment configuration
# Copy to backend/.env and adjust. Never commit .env files.
# =========================================================================

# Django
DJANGO_SECRET_KEY="change-me-to-a-long-random-string"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_TIME_ZONE="UTC"

# Database (omit to use SQLite in ./backend/db.sqlite3)
# DATABASE_URL="postgres://voice_user:voice_pass@localhost:5432/voice_of_a_girl"

# JWT lifetimes
ACCESS_TOKEN_HOURS="6"
REFRESH_TOKEN_DAYS="7"

# CORS / security
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CSRF_TRUSTED_ORIGINS="http://localhost:5173"
SESSION_COOKIE_SECURE="False"

# Public survey link base URL (what the React app uses to open surveys)
PUBLIC_SURVEY_BASE_URL="http://localhost:5173"

# Throttling
THROTTLE_LOGIN="10/min"
THROTTLE_PUBLIC_SURVEY="120/hour"
THROTTLE_PUBLIC_SUBMIT="10/hour"