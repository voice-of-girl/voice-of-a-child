# --- Django core ---
DJANGO_SECRET_KEY=voice-of-a-girl-dev-secret-key-change-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=UTC

# --- Database ---
# PostgreSQL is used in production. SQLite is used automatically when unset.
# DATABASE_URL=postgres://voice_user:voice_pass@localhost:5432/voice_of_a_girl_db

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- DRF ---
PAGE_SIZE=20
